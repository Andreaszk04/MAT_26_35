        <dc:Bounds x="1575" y="520" width="130" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParJoin_di" bpmnElement="ParJoin">
        <dc:Bounds x="1745" y="435" width="50" height="50" />
