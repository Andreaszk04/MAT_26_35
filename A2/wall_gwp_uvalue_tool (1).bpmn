        <dc:Bounds x="2195" y="695" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2172" y="750" width="96" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_Report_di" bpmnElement="DO_Report" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="2632" y="695" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2619" y="750" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Upload_di" bpmnElement="Flow_Start_Upload">
        <di:waypoint x="278" y="160" />
        <di:waypoint x="325" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Upload_Load_di" bpmnElement="Flow_Upload_Load">
        <di:waypoint x="390" y="200" />
