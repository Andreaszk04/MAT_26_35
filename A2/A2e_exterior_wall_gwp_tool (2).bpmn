      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CalcTot_di" bpmnElement="CalcTot">
        <dc:Bounds x="1725" y="420" width="130" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ChkBR_di" bpmnElement="ChkBR">
        <dc:Bounds x="1895" y="420" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwBR_di" bpmnElement="GwBR" isMarkerVisible="true">
        <dc:Bounds x="2075" y="435" width="50" height="50" />
