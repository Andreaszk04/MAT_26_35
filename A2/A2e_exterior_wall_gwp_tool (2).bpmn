        <dc:Bounds x="1425" y="695" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1399" y="750" width="104" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_BR18_di" bpmnElement="DS_BR18" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="1935" y="695" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1926" y="750" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_Report_di" bpmnElement="DO_Report" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="2362" y="695" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2349" y="750" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_IDS_di" bpmnElement="DO_IDS" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="412" y="695" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="413" y="750" width="37" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_IFC_di" bpmnElement="DO_IFC" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="322" y="695" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="315" y="750" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Upload_di" bpmnElement="Flow_Start_Upload">
        <di:waypoint x="278" y="160" />
        <di:waypoint x="325" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fix_Upload_di" bpmnElement="Flow_Fix_Upload">
        <di:waypoint x="485" y="160" />
        <di:waypoint x="455" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Upload_ChkReq_di" bpmnElement="Flow_Upload_ChkReq">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="390" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ChkReq_GwReq_di" bpmnElement="Flow_ChkReq_GwReq">
        <di:waypoint x="455" y="460" />
